# Public site URL used for metadata and canonical links (no trailing slash).
# Local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production on the VPS:
# NEXT_PUBLIC_SITE_URL=https://design.vaybik.ru

# Compose on the VPS (/opt/apps/design-atlas/.env) also uses:
# APP_NAME=design-atlas
# APP_HOST=design.vaybik.ru
# APP_PORT=3000
# COMPOSE_PROJECT_NAME=design-atlas
# NODE_ENV=production

# Optional analytics / monitoring (leave empty in local development)
# NEXT_PUBLIC_ANALYTICS_ID=
