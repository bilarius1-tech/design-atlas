{
  "schemaVersion": "1.0.0",
  "styleId": "aurora-mesh",
  "families": {
    "heading": "Manrope",
    "body": "Manrope",
    "mono": "IBM Plex Mono",
    "fallbacks": ["Unbounded", "Inter", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "600",
      "lineHeight": "1.05",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "42px",
      "weight": "600",
      "lineHeight": "1.1",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "28px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.6"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.6"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "11px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.1em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Manrope for display and body — calm, Cyrillic-ready white type on night.",
    "Unbounded optional for short hero punches; do not shout every line.",
    "Keep display at 57px; air over dense stacks."
  ],
  "constraints": [
    "Do not harden into neon-tech grid type.",
    "Do not use neo-brutal uppercase Impact energy.",
    "Do not bury type in low-contrast mesh without AA."
  ]
}
