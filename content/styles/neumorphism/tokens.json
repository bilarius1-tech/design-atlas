{
  "schemaVersion": "1.0.0",
  "meta": {
    "styleId": "neumorphism",
    "name": "Neumorphism tokens"
  },
  "colors": {
    "background": "#E6EBF2",
    "surface": "#E6EBF2",
    "text": "#2E3440",
    "muted": "#6B7380",
    "primary": "#3D5AFE",
    "accent": "#3D5AFE",
    "border": "#D7DDE6",
    "accentSecondary": "#C3CAD5"
  },
  "typography": {
    "heading": "Manrope, Inter, Helvetica Neue, Arial, sans-serif",
    "body": "Manrope, Inter, Helvetica Neue, Arial, sans-serif",
    "mono": "IBM Plex Mono, ui-monospace, monospace",
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "36px",
