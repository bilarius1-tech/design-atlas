{
  "schemaVersion": "1.0.0",
  "styleId": "neumorphism",
  "families": {
    "heading": "Manrope",
    "body": "Manrope",
    "mono": "IBM Plex Mono",
    "fallbacks": ["Inter", "Helvetica Neue", "Arial", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "700",
      "lineHeight": "1.08",
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "family": "heading",
      "size": "36px",
      "weight": "700",
      "lineHeight": "1.12",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "24px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "12px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.04em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "500",
      "lineHeight": "1.35"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Use Manrope for UI text; Inter only as fallback.",
    "Keep display moderate (57px) — soft UI, not poster type.",
    "Prefer medium weights over ultra-black."
  ],
  "constraints": [
    "Do not default to Inter-only stacks without Manrope.",
    "Do not pair soft shadows with aggressive display faces.",
    "Do not reduce text contrast for the sake of soft aesthetics."
  ]
}
