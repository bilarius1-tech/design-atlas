{
  "schemaVersion": "1.0.0",
  "styleId": "poster-brutal",
  "families": {
    "heading": "Arial Black",
    "body": "Arial",
    "mono": "ui-monospace",
    "fallbacks": [
      "Impact",
      "Haettenschweiler",
      "Helvetica",
      "sans-serif"
    ]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "88px",
      "weight": "900",
      "lineHeight": "0.92",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "52px",
      "weight": "900",
      "lineHeight": "1.0",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "32px",
      "weight": "900",
      "lineHeight": "1.05",
      "letterSpacing": "-0.01em"
    },
    "h3": {
      "family": "heading",
      "size": "22px",
      "weight": "900",
      "lineHeight": "1.15"
    },
    "h4": {
      "family": "body",
      "size": "16px",
      "weight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "0.06em"
    },
    "bodyLarge": {
      "family": "body",
      "size": "22px",
      "weight": "400",
      "lineHeight": "1.4"
    },
    "body": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.45"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "400",
      "lineHeight": "1.35"
    },
    "label": {
      "family": "body",
      "size": "12px",
      "weight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "0.14em"
    },
    "quote": {
      "family": "heading",
      "size": "32px",
      "weight": "900",
      "lineHeight": "1.1",
      "letterSpacing": "-0.02em"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.4"
    }
  },
  "rules": [
    "Use oversized display type and thick rules before adding a second accent color.",
    "Hard offset shadows only — no soft blur shadows.",
    "Keep geometry sharp (radius 0) with 3px borders."
  ],
  "constraints": [
    "Do not soften into rounded pastel cards.",
    "Do not replace Arial Black stack with Inter or script faces.",
    "Do not sprinkle sticker badges over hero media."
  ]
}
