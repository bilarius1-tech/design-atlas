{
  "schemaVersion": "1.0.0",
  "styleId": "neo-brutalism",
  "families": {
    "heading": "Unbounded",
    "body": "Rubik",
    "mono": "JetBrains Mono",
    "fallbacks": ["Space Grotesk", "Arial Black", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "800",
      "lineHeight": "1.02",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "44px",
      "weight": "800",
      "lineHeight": "1.08",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "28px",
      "weight": "700",
      "lineHeight": "1.15"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "700",
      "lineHeight": "1.2"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "700",
      "lineHeight": "1.25"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "11px",
      "weight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "700",
      "lineHeight": "1.3"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Unbounded for display/headings — weight 800, uppercase allowed.",
    "Rubik for body — Cyrillic-ready; Space Grotesk is Latin fallback only.",
    "Keep display at 57px; short lines beat long essays."
  ],
  "constraints": [
    "Do not lead with Arial Black / Impact (that’s poster-brutal).",
    "Do not soften type with glass/neu blur aesthetics.",
    "Do not apply dense-tile flush mosaics that hide hard offsets."
  ]
}
