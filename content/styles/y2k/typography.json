{
  "schemaVersion": "1.0.0",
  "styleId": "y2k",
  "families": {
    "heading": "Unbounded",
    "body": "Nunito",
    "mono": "IBM Plex Mono",
    "fallbacks": ["Russo One", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "800",
      "lineHeight": "1.02",
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "family": "heading",
      "size": "42px",
      "weight": "800",
      "lineHeight": "1.08",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "28px",
      "weight": "700",
      "lineHeight": "1.15"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "700",
      "lineHeight": "1.2"
    },
    "h4": {
      "family": "body",
      "size": "14px",
      "weight": "700",
      "lineHeight": "1.25"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "600",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "11px",
      "weight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "700",
      "lineHeight": "1.3"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Unbounded chrome display — weight 800; Nunito for friendly body.",
    "Russo One optional for short punches; keep Cyrillic coverage.",
    "Keep display at 57px; short playful lines beat long essays."
  ],
  "constraints": [
    "Do not harden into neon-tech dark grid type.",
    "Do not drift into streetwear peach + lime campaign default.",
    "Do not bury chrome type without a readable stroke/contrast pair."
  ]
}
