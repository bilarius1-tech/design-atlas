{
  "schemaVersion": "1.0.0",
  "styleId": "blueprint-grid",
  "families": {
    "heading": "Roboto Mono",
    "body": "Oswald",
    "mono": "Roboto Mono",
    "fallbacks": ["Manrope", "DM Sans", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "500",
      "lineHeight": "1.08",
      "letterSpacing": "-0.04em"
    },
    "h1": {
      "family": "heading",
      "size": "36px",
      "weight": "500",
      "lineHeight": "1.12",
      "letterSpacing": "-0.03em"
    },
    "h2": {
      "family": "heading",
      "size": "24px",
      "weight": "500",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "500",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.5"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "mono",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "mono",
      "size": "11px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "20px",
      "weight": "400",
      "lineHeight": "1.35"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Roboto Mono carries display and technical labels.",
    "Keep display at 57px.",
    "Prefer measured spacing; avoid dense streetwear stacking."
  ],
  "constraints": [
    "Do not replace mono headings with Inter display.",
    "Do not invent dimension numbers in handoff prompts.",
    "Do not wash the grid with neon bloom."
  ]
}
