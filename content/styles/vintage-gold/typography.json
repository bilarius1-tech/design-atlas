{
  "schemaVersion": "1.0.0",
  "styleId": "vintage-gold",
  "families": {
    "heading": "Playfair Display",
    "body": "Manrope",
    "mono": "IBM Plex Mono",
    "fallbacks": ["Cormorant Garamond", "Georgia", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "600",
      "lineHeight": "1.08",
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "family": "heading",
      "size": "40px",
      "weight": "600",
      "lineHeight": "1.12",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "28px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "20px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "16px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.65"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.65"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "11px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.12em"
    },
    "quote": {
      "family": "heading",
      "size": "24px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Playfair Display for display/headings; Manrope for body with Cyrillic.",
    "Keep display at 57px.",
    "Editorial restraint — short headlines, airy captions."
  ],
  "constraints": [
    "Do not invent awards, dates, seals, or logos.",
    "Do not flood gold across every surface.",
    "Do not distress or age product materials in prompts."
  ]
}
