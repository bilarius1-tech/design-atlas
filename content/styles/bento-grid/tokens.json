{
  "schemaVersion": "1.0.0",
  "meta": {
    "styleId": "bento-grid",
    "name": "Bento Grid tokens"
  },
  "colors": {
    "background": "#F5F5F7",
    "surface": "#FFFFFF",
    "text": "#1D1D1F",
    "muted": "#6E6E73",
    "primary": "#0A84FF",
    "accent": "#FFD60A",
    "accentSecondary": "#34C759",
    "border": "#E5E5EA"
  },
  "typography": {
    "heading": "Inter, Manrope, Onest, system-ui, sans-serif",
    "body": "Manrope, Inter, Onest, system-ui, sans-serif",
    "mono": "IBM Plex Mono, ui-monospace, monospace",
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "26px",
      "2xl": "40px",
      "display": "57px"
    }
  },
  "spacing": {
    "unit": 8,
    "section": "96px",
    "container": "1120px",
    "gap": "16px"
  },
  "geometry": {
    "radius": "16px",
    "radiusButton": "999px",
    "radiusCard": "24px",
    "borderWidth": "1px"
  },
  "effects": {
    "shadow": "0 10px 30px rgba(29, 29, 31, 0.06)",
    "transition": "160ms"
  }
}
