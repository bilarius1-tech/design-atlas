{
  "schemaVersion": "1.0.0",
  "styleId": "midnight-console",
  "families": {
    "heading": "IBM Plex Sans",
    "body": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "fallbacks": [
      "Helvetica Neue",
      "Arial",
      "sans-serif"
    ]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "600",
      "lineHeight": "1.05",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "36px",
      "weight": "600",
      "lineHeight": "1.12",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "24px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "-0.01em"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3",
      "letterSpacing": "0.04em"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.5"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "400",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "mono",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "24px",
      "weight": "400",
      "lineHeight": "1.35",
      "letterSpacing": "-0.01em"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Prefer mono labels for status, IDs, and secondary metadata.",
    "Keep surfaces dark; reserve cyan/mint for signal, not large washes.",
    "Dense but readable: engineering products tolerate tighter rhythm than editorial posters."
  ],
  "constraints": [
    "Do not brighten the page into a light theme.",
    "Do not replace IBM Plex with Inter as a silent default.",
    "Do not use neon glow stacks or glassmorphism panels as identity."
  ]
}
