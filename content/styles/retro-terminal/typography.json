{
  "schemaVersion": "1.0.0",
  "styleId": "retro-terminal",
  "families": {
    "heading": "JetBrains Mono",
    "body": "JetBrains Mono",
    "mono": "JetBrains Mono",
    "fallbacks": ["PT Mono", "ui-monospace", "monospace"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "700",
      "lineHeight": "1.05",
      "letterSpacing": "-0.02em"
    },
    "h1": {
      "family": "heading",
      "size": "38px",
      "weight": "700",
      "lineHeight": "1.1"
    },
    "h2": {
      "family": "heading",
      "size": "26px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "400",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "11px",
      "weight": "500",
      "lineHeight": "1.2",
      "letterSpacing": "0.04em"
    },
    "quote": {
      "family": "heading",
      "size": "20px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "All roles are monospace — JetBrains Mono primary, PT Mono fallback.",
    "Headings may read as CLI prompts (`> command`).",
    "Keep display at 57px; phosphor glow via CSS, not fake bitmaps."
  ],
  "constraints": [
    "Do not introduce sans display as the hero system (midnight-console drift).",
    "Do not multi-neon lime/magenta like neon-tech.",
    "Do not animate cursor when prefers-reduced-motion is set."
  ]
}
