{
  "schemaVersion": "1.0.0",
  "styleId": "apple-materials",
  "families": { "heading": "Inter", "body": "Inter", "mono": "IBM Plex Mono", "fallbacks": ["system-ui", "sans-serif"] },
  "roles": {
    "display": { "family": "heading", "size": "57px", "weight": "600", "lineHeight": "1.05", "letterSpacing": "-0.03em" },
    "h1": { "family": "heading", "size": "40px", "weight": "700", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
    "h2": { "family": "heading", "size": "26px", "weight": "600", "lineHeight": "1.2" },
    "h3": { "family": "heading", "size": "18px", "weight": "600", "lineHeight": "1.25" },
    "h4": { "family": "heading", "size": "14px", "weight": "600", "lineHeight": "1.3" },
    "bodyLarge": { "family": "body", "size": "18px", "weight": "400", "lineHeight": "1.55" },
    "body": { "family": "body", "size": "16px", "weight": "400", "lineHeight": "1.55" },
    "caption": { "family": "body", "size": "12px", "weight": "500", "lineHeight": "1.4" },
    "label": { "family": "body", "size": "11px", "weight": "600", "lineHeight": "1.2", "letterSpacing": "0.06em" },
    "quote": { "family": "heading", "size": "22px", "weight": "500", "lineHeight": "1.35" },
    "code": { "family": "mono", "size": "14px", "weight": "400", "lineHeight": "1.45" }
  },
  "rules": ["Use tokens from tokens.json.", "Keep display at 57px.", "Cyrillic-ready fonts preferred."],
  "constraints": ["Do not invent a second palette.", "Respect prefers-reduced-motion."]
}