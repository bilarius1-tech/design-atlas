{
  "schemaVersion": "1.0.0",
  "meta": {
    "styleId": "clinical-minimal",
    "name": "Clinical Minimal tokens"
  },
  "colors": {
    "background": "#F3F7F8",
    "surface": "#FFFFFF",
    "text": "#24333A",
    "muted": "#587583",
    "primary": "#4386A8",
    "accent": "#58A69A",
    "accentSecondary": "#718FC9",
    "border": "#C9D6DC"
  },
  "typography": {
    "heading": "Manrope, DM Sans, Roboto, system-ui, sans-serif",
    "body": "Manrope, DM Sans, Roboto, system-ui, sans-serif",
    "mono": "Roboto Mono, ui-monospace, monospace",
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "36px",
      "display": "57px"
    }
  },
  "spacing": {
    "unit": 8,
    "section": "96px",
    "container": "1120px"
