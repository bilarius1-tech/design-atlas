{
  "schemaVersion": "1.0.0",
  "styleId": "clinical-minimal",
  "families": {
    "heading": "Manrope",
    "body": "Manrope",
    "mono": "Roboto Mono",
    "fallbacks": ["DM Sans", "Roboto", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "600",
      "lineHeight": "1.08",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "36px",
      "weight": "600",
      "lineHeight": "1.12",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "24px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "mono",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "mono",
      "size": "11px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "500",
      "lineHeight": "1.35"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Manrope for headings and body; mono for technical captions.",
    "Keep display at 57px.",
    "Prefer neutral letter-spacing — not fashion display."
  ],
  "constraints": [
    "Do not invent medical approvals or therapeutic claims.",
    "Do not warm into soft-editorial paper + Playfair.",
    "Do not flood neon accents."
  ]
}
