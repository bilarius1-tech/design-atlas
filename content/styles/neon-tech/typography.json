{
  "schemaVersion": "1.0.0",
  "styleId": "neon-tech",
  "families": {
    "heading": "Unbounded",
    "body": "Oswald",
    "mono": "Roboto Mono",
    "fallbacks": ["Manrope", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "600",
      "lineHeight": "1.05",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "40px",
      "weight": "600",
      "lineHeight": "1.1",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "26px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.5"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "mono",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "mono",
      "size": "12px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "500",
      "lineHeight": "1.35"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Unbounded for display/headings; Oswald or Manrope for body with Cyrillic.",
    "Keep display at 57px.",
    "Mono labels for metadata and technical captions."
  ],
  "constraints": [
    "Do not replace Unbounded with Inter/Roboto for display.",
    "Do not put thin gray type on charcoal.",
    "Do not let neon glow wash out text contrast."
  ]
}
