{
  "schemaVersion": "1.0.0",
  "styleId": "scandi-calm",
  "families": {
    "heading": "Manrope",
    "body": "Manrope",
    "mono": "IBM Plex Mono",
    "fallbacks": ["DM Sans", "system-ui", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "57px",
      "weight": "500",
      "lineHeight": "1.08",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "38px",
      "weight": "600",
      "lineHeight": "1.12",
      "letterSpacing": "-0.02em"
    },
    "h2": {
      "family": "heading",
      "size": "26px",
      "weight": "600",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "18px",
      "weight": "600",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "14px",
      "weight": "600",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "18px",
      "weight": "400",
      "lineHeight": "1.65"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.65"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "11px",
      "weight": "600",
      "lineHeight": "1.2",
      "letterSpacing": "0.1em"
    },
    "quote": {
      "family": "heading",
      "size": "22px",
      "weight": "500",
      "lineHeight": "1.4"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Manrope for display and body — calm, friendly, Cyrillic-ready.",
    "Keep display at 57px with medium weight for softness.",
    "Prefer air and short lines over dense stacks."
  ],
  "constraints": [
    "Do not lead with Playfair fashion-journal energy (that’s soft-editorial).",
    "Do not apply dense-tile flush mosaics.",
    "Do not invent hygge clutter or fake wood noise."
  ]
}
