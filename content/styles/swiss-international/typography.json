{
  "schemaVersion": "1.0.0",
  "styleId": "swiss-international",
  "families": {
    "heading": "Helvetica Neue",
    "body": "Helvetica Neue",
    "mono": "IBM Plex Mono",
    "fallbacks": ["Helvetica", "Arial", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "80px",
      "weight": "700",
      "lineHeight": "0.98",
      "letterSpacing": "-0.04em"
    },
    "h1": {
      "family": "heading",
      "size": "44px",
      "weight": "700",
      "lineHeight": "1.08",
      "letterSpacing": "-0.03em"
    },
    "h2": {
      "family": "heading",
      "size": "28px",
      "weight": "700",
      "lineHeight": "1.15",
      "letterSpacing": "-0.02em"
    },
    "h3": {
      "family": "heading",
      "size": "20px",
      "weight": "700",
      "lineHeight": "1.2"
    },
    "h4": {
      "family": "heading",
      "size": "16px",
      "weight": "700",
      "lineHeight": "1.25",
      "letterSpacing": "0.02em"
    },
    "bodyLarge": {
      "family": "body",
      "size": "20px",
      "weight": "400",
      "lineHeight": "1.45"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "400",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "12px",
      "weight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "0.12em"
    },
    "quote": {
      "family": "heading",
      "size": "28px",
      "weight": "400",
      "lineHeight": "1.25",
      "letterSpacing": "-0.02em"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Default alignment is flush left; center only for rare isolated marks.",
    "Create hierarchy with scale and weight before introducing a second color.",
    "Prefer uneven column spans (e.g. 7/5) over perfectly mirrored marketing stacks.",
    "Uppercase labels use tracked letter-spacing; body copy does not."
  ],
  "constraints": [
    "Do not introduce script, slab novelty, or decorative display faces.",
    "Do not soft-round corners to ‘modernize’ the system.",
    "Do not replace Helvetica lineage with Inter as a silent default.",
    "If Helvetica Neue cannot be licensed for embedding, keep the CSS stack and document the fallback (Arial)."
  ]
}
