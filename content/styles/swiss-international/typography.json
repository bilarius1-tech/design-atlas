{
  "schemaVersion": "1.0.0",
  "styleId": "swiss-international",
  "families": {
    "heading": "Helvetica Neue",
    "body": "Helvetica Neue",
    "mono": "IBM Plex Mono",
    "fallbacks": ["Arial", "Helvetica", "sans-serif"]
  },
  "roles": {
    "display": {
      "family": "heading",
      "size": "72px",
      "weight": "700",
      "lineHeight": "1.05",
      "letterSpacing": "-0.03em"
    },
    "h1": {
      "family": "heading",
      "size": "40px",
      "weight": "700",
      "lineHeight": "1.15"
    },
    "h2": {
      "family": "heading",
      "size": "28px",
      "weight": "700",
      "lineHeight": "1.2"
    },
    "h3": {
      "family": "heading",
      "size": "20px",
      "weight": "700",
      "lineHeight": "1.25"
    },
    "h4": {
      "family": "heading",
      "size": "16px",
      "weight": "700",
      "lineHeight": "1.3"
    },
    "bodyLarge": {
      "family": "body",
      "size": "20px",
      "weight": "400",
      "lineHeight": "1.5"
    },
    "body": {
      "family": "body",
      "size": "16px",
      "weight": "400",
      "lineHeight": "1.55"
    },
    "caption": {
      "family": "body",
      "size": "12px",
      "weight": "400",
      "lineHeight": "1.4"
    },
    "label": {
      "family": "body",
      "size": "12px",
      "weight": "700",
      "lineHeight": "1.2",
      "letterSpacing": "0.08em"
    },
    "quote": {
      "family": "heading",
      "size": "28px",
      "weight": "400",
      "lineHeight": "1.3"
    },
    "code": {
      "family": "mono",
      "size": "14px",
      "weight": "400",
      "lineHeight": "1.45"
    }
  },
  "rules": [
    "Prefer flush-left alignment.",
    "Use weight and scale for hierarchy before color."
  ],
  "constraints": [
    "Do not introduce decorative script fonts.",
    "Keep corner radius at 0 unless a functional exception is documented."
  ]
}
